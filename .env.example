# Copy to .env.local for local development. Never commit real values.

# Postgres. Locally this is a plain connection string. On Vercel both values are
# injected by the Neon integration; the unpooled one is used for migrations.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/spongecake
DATABASE_URL_UNPOOLED=

# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob. Injected by the Blob store integration on Vercel.
# Leave empty locally to store uploads on disk under /media.
BLOB_READ_WRITE_TOKEN=

# Resend. Leave the key empty locally and emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Spongecake <spongecake@send.woodheadrestaurantgroup.co.uk>"

# Email of the first Group Admin. Only used while the users table is empty:
# the first sign-in request from this address creates the account.
BOOTSTRAP_ADMIN_EMAIL=

# Which site a request resolves to when the hostname matches no site.
# Set in Preview and Development only, never in Production.
DEFAULT_SITE_SLUG=qch
